# ==============================================================================
# Trust Vault Cloud & Application Environment Variables
# ==============================================================================

# Turso Cloud Database Configuration
TURSO_DATABASE_URL=https://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-jwt

# Backblaze B2 Object Storage Configuration
B2_BUCKET_NAME=your-bucket-name
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com

# JWT Authentication Security
JWT_SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Configuration
ADMIN_EMAIL=guardfilespace@gmail.com
ADMIN_DEFAULT_PASSWORD=Arshad@1234
ADMIN_MASTER_CODE=ADMIN-MASTER-KEY

# Application Runtime & Upload Constraints
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25

# Email Delivery Configuration (Gmail SMTP Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=guardfilespace@gmail.com
SMTP_PASSWORD=your-gmail-16-char-app-password
SMTP_FROM_EMAIL=guardfilespace@gmail.com
SMTP_FROM_NAME=Trust Vault Security
